#!/bin/bash
#PBS -J 0-43
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=20:00:00
#PBS -N rmt_3954
#PBS -o logs/
#PBS -e logs/

# Load Python module
# Python/3.12.3-GCCcore-13.3.0
module load SciPy-bundle/2024.05-gfbf-2024a

# Change to working directory
cd $PBS_O_WORKDIR

# Create output directories
mkdir -p results
mkdir -p logs

# Verify Python script exists
if [ ! -f "3954-rmt-3node-hpc.py" ]; then
    echo "ERROR: 3954-rmt-3node-hpc.py not found in $PBS_O_WORKDIR"
    exit 1
fi

# Run Python script with array index
echo "Starting job ${PBS_ARRAY_INDEX} at $(date)"
python 3954-rmt-3node-hpc.py $PBS_ARRAY_INDEX
echo "Finished job ${PBS_ARRAY_INDEX} at $(date)"
