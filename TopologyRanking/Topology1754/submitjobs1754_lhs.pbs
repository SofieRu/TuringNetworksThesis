#!/bin/bash
#PBS -J 0-46
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=44:00:00
#PBS -N lhs_1754
#PBS -o logs/
#PBS -e logs/

# Load Python module
# Python/3.12.3-GCCcore-13.3.0
module load SciPy-bundle/2024.05-gfbf-2024a
 
# Change to working directory
cd $PBS_O_WORKDIR

# Create output directories
mkdir -p results
mkdir -p logs

# Run Python script with array index
echo "Starting job ${PBS_ARRAY_INDEX} at $(date)"
python 1754-lhs-3node-hpc.py $PBS_ARRAY_INDEX --save-params --n-to-save=100
echo "Finished job ${PBS_ARRAY_INDEX} at $(date)"